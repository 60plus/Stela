From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: kiki <duarduar707@gmail.com>
Date: Mon, 16 Nov 2026 16:58:20 +0000
Subject: [PATCH] fix(nouveau): an eDP panel on GSP-RM gets backlight control
 and is lit fully once its SOR runs, where r535_dp had no backlight hooks and
 a laptop panel driven by its discrete GPU stayed dark after the
 function-level reset

---
 drivers/gpu/drm/nouveau/dispnv50/disp.c           | 15 +++++++++++++++
 .../drm/nouveau/nvkm/subdev/gsp/rm/r535/disp.c    |  8 ++++++++
 2 files changed, 23 insertions(+)

diff --git a/drivers/gpu/drm/nouveau/dispnv50/disp.c b/drivers/gpu/drm/nouveau/dispnv50/disp.c
index 364227f5456f11dff1c6ae5558e6f29ebfddf082..95185e5334f47df17245fecd999d5a1fe80ed5ba 100644
--- a/drivers/gpu/drm/nouveau/dispnv50/disp.c
+++ b/drivers/gpu/drm/nouveau/dispnv50/disp.c
@@ -1852,6 +1852,21 @@ nv50_sor_atomic_enable(struct drm_encoder *encoder, struct drm_atomic_commit *st
 		head->func->display_id(head, BIT(nv_encoder->outp.id));
 
 	nv_encoder->update(nv_encoder, nv_crtc->index, asyh, proto, depth);
+
+#ifndef CONFIG_DRM_NOUVEAU_BACKLIGHT
+	/*
+	 * Without the backlight class nothing sets an eDP panel's brightness,
+	 * and after a function-level reset GSP-RM leaves it dark: light it
+	 * fully once the SOR runs, as no user can raise it.
+	 */
+	if (nv_connector->type == DCB_CONNECTOR_eDP) {
+		int before = nvif_outp_bl_get(outp);
+		int ret = nvif_outp_bl_set(outp, 100);
+
+		NV_INFO(drm, "eDP backlight: was %d, set 100: %d, now %d\n",
+			before, ret, nvif_outp_bl_get(outp));
+	}
+#endif
 }
 
 static const struct drm_encoder_helper_funcs
diff --git a/drivers/gpu/drm/nouveau/nvkm/subdev/gsp/rm/r535/disp.c b/drivers/gpu/drm/nouveau/nvkm/subdev/gsp/rm/r535/disp.c
index f5f22173fc2c123cf670ffeab205205d4178bc5a..21a2675868e38e8a42f416d73bc3fcab62507f95 100644
--- a/drivers/gpu/drm/nouveau/nvkm/subdev/gsp/rm/r535/disp.c
+++ b/drivers/gpu/drm/nouveau/nvkm/subdev/gsp/rm/r535/disp.c
@@ -1158,6 +1158,14 @@ r535_dp = {
 	.dp.rates = r535_dp_rates,
 	.dp.train = r535_dp_train,
 	.dp.drive = r535_dp_drive,
+	/*
+	 * An eDP panel's backlight goes through GSP-RM's
+	 * NV0073_CTRL_CMD_SPECIFIC_{GET,SET}_BACKLIGHT_BRIGHTNESS, which
+	 * r535_sor_bl already sends; without these the panel had no backlight
+	 * control and stayed dark after a function-level reset.
+	 */
+	.bl.get = nvkm_outp_bl_get,
+	.bl.set = nvkm_outp_bl_set,
 };
 
 static int
