pci_bus_resource_n
pci_clear_master
pci_enable_atomic_ops_to_root
pci_find_ext_capability
pci_get_class
pci_load_saved_state
pci_rebar_bytes_to_size
pci_rebar_get_max_size
pci_reset_function
pci_resize_resource
pci_restore_msi_state
pci_store_saved_state
pci_wait_for_pending_transaction
pci_wake_from_d3
pcie_capability_read_word
pcie_get_mps
pcie_get_speed_cap
pcie_get_width_cap

# Interrupt lines: masking a requested line.
disable_irq
enable_irq

# DMA: mapping a device resource, and the addressing-limit query.
dma_addressing_limited
dma_map_resource
dma_unmap_resource

# Device model: attribute files and groups, devres groups, device links,
