# The kernel services amdgpu reaches when linked, directly or through the
# objects of Stela's Linux environment, that nothing supplies yet or that the
# environment defines only as a trap, by service. `build/amdgpu.rs` fails the
# build when this list and the compiled imports differ.

# DRM clients and the panel backlight quirks, unchanged files that wait for
# their Kconfig selections (PENDING in amdgpu.rs): drm_client*.c,
# drm_panel_backlight_quirks.c.
drm_client_init
drm_client_register
drm_client_release
drm_get_panel_backlight_quirk

# hwmon and backlight class devices, which amdgpu's Kconfig entry selects
# (PENDING in amdgpu.rs).
backlight_device_register
backlight_device_unregister
hwmon_device_register_with_groups
hwmon_device_unregister

# Library code: lib/vsprintf.c's sscanf.
sscanf

# PCI: growing a BAR, a trap; BARs keep the sizes the firmware gave.
pci_resize_resource

# Device model: device links (a trap and its undoing) and the platform devices
# of a partitioned accelerator.
device_link_add
device_link_del
platform_device_register_full
platform_device_unregister

# Memory and system: whether a physical page is RAM, emergency restart.
emergency_restart
page_is_ram

# Traps the environment defines without serving, as nouveau's list has them:
# shmem-backed pages and the page cache (TTM allocates from its own pool here),
# and reopening a file without a VFS path.
folio_clear_dirty_for_io
mm_get_unmapped_area
shmem_read_folio_gfp
shmem_read_mapping_page_gfp
shmem_truncate_range
shmem_writeout
stela_linux_reopen_unowned_path
