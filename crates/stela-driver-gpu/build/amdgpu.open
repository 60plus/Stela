amdgpu_irq_add_id
amdgpu_irq_delegate
amdgpu_irq_disable_all
amdgpu_irq_dispatch
amdgpu_irq_enabled
amdgpu_irq_fini_hw
amdgpu_irq_fini_sw
amdgpu_irq_get
amdgpu_irq_gpu_reset_resume_helper
amdgpu_irq_init
amdgpu_irq_put
amdgpu_irq_remove_domain
amdgpu_irq_update
amdgpu_restore_msix
node_id_to_phys_map
soc15_ih_clientid_name
soc_v1_0_ih_clientid_name

